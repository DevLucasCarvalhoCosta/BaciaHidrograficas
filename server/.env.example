# ============================================
# CONFIGURAÇÃO DO BACKEND
# ============================================

# Porta do servidor
PORT=3001

# Ambiente de execução
NODE_ENV=development

# ============================================
# API DA ANA (Agência Nacional de Águas)
# ============================================
# URL base da API da ANA
ANA_BASE_URL=https://api.ana.gov.br/hidrowebservice

# Credenciais de acesso à API (obtenha em: https://www.ana.gov.br/)
ANA_IDENTIFICADOR=seu_identificador
ANA_SENHA=sua_senha

# Timeout para requisições à API (ms)
ANA_REQUEST_TIMEOUT=60000

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ana_hidro?schema=public"
